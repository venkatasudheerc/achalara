# Database
DATABASE_URL=postgresql://postgres:dev123@localhost:5432/pms_dev

# Google Sheets (for CSV/Sheets import)
GOOGLE_SHEETS_API_KEY=your_api_key_here
GOOGLE_SHEETS_CREDENTIALS_FILE=./credentials.json

# Webull market data
WEBULL_APP_KEY=your_webull_app_key_here
WEBULL_APP_SECRET=your_webull_app_secret_here

# SnapTrade brokerage connections (Bridge).
# Get these from the SnapTrade dashboard. A Personal API key is enough to link
# your own accounts; multi-client use needs a Commercial key.
SNAPTRADE_CLIENT_ID=your_snaptrade_client_id_here
SNAPTRADE_CONSUMER_KEY=your_snaptrade_consumer_key_here
# The userId your brokerage logins are linked under (any stable string).
SNAPTRADE_USER_ID=your_snaptrade_user_id_here

# Redis (for scheduler)
REDIS_URL=redis://localhost:6379/0

# Application
PYTHON_ENV=development
LOG_LEVEL=DEBUG
PORT=8000

# Scheduler
SCHEDULER_ENABLED=true

# CORS — comma-separated list of allowed frontend origins.
# Add your production URL(s) here; localhost:5173 covers local dev.
CORS_ALLOW_ORIGINS=http://localhost:5173

# Sign-in. How long a session lasts, in hours (default 168 = 7 days).
# Create the first advisor login with:  python -m app.cli create-advisor
SESSION_TTL_HOURS=168
