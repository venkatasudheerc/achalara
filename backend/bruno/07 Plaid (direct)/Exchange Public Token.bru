meta {
  name: Exchange Public Token
  type: http
  seq: 2
}

post {
  url: {{plaidBaseUrl}}/item/public_token/exchange
  body: json
  auth: none
}

body:json {
  {
    "public_token": "{{plaidPublicToken}}"
  }
}

vars:post-response {
  plaidAccessToken: res.body.access_token
  plaidItemId: res.body.item_id
}

assert {
  res.status: eq 200
  res.body.access_token: isString
  res.body.item_id: isString
}

docs {
  The access key for the login. The backend does this itself in `finish` and stores the
  key only encrypted; here it is kept for the requests that follow and is never written
  anywhere.
}
