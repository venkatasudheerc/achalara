meta {
  name: Create Strategy
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/strategies/
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "{{strategyName}}",
    "description": "Long-only US equity growth strategy"
  }
}

script:pre-request {
  // Names are unique, so each run makes its own: re-running never answers 409.
  bru.setVar("strategyName", "Growth " + Date.now());
}

vars:post-response {
  strategyId: res.body.id
}

assert {
  res.status: eq 201
  res.body.name: eq {{strategyName}}
}

docs {
  Creates a firm-wide (global) strategy DEFINITION. Apply it to an account by creating a
  Sleeve (next request). Trades, positions and performance live at the sleeve level.

  Names are unique case-insensitively, so a repeat returns 409; each run adds a timestamp to
  the name so that re-running never does.
}
