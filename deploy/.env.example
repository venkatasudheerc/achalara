# Copy to deploy/.env on the server, fill in, then: chmod 600 deploy/.env
# Never commit the filled-in file.

# The site's address, without https://
DOMAIN=example.com

# The database. A long random password of letters and digits only (openssl rand -hex 32):
# it becomes part of an address, where other characters would need escaping.
POSTGRES_USER=achalara
POSTGRES_DB=achalara
POSTGRES_PASSWORD=

# Webull market data
WEBULL_APP_KEY=
WEBULL_APP_SECRET=

# SnapTrade brokerage connections
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=
SNAPTRADE_USER_ID=

# Alerts to your phone when something needs a look (optional; see DEPLOY.md).
# Leave both empty for none.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email to clients: their invite and password-reset links (optional; see DEPLOY.md).
# Leave both empty and links are passed on by hand.
RESEND_API_KEY=
MAIL_FROM=

# How long a sign-in lasts, in hours
SESSION_TTL_HOURS=168
LOG_LEVEL=INFO

# Market data (the md worker). The SEC requires a contact email in requests to EDGAR;
# leave empty to skip SEC lookups. OpenFIGI works without a key, more slowly.
SEC_CONTACT_EMAIL=
OPENFIGI_API_KEY=
# Only if market data has a database of its own. Empty: it shares the app's.
MD_DATABASE_URL=
# The read-only login research uses (deploy/create-md-reader.sh creates it from this password).
# Then: MD_READ_DATABASE_URL=postgresql://md_reader:<that password>@db:5432/<POSTGRES_DB>
MD_READER_PASSWORD=
MD_READ_DATABASE_URL=
