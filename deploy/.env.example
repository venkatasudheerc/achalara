# Copy to deploy/.env on the server, fill in, then: chmod 600 deploy/.env
# Never commit the filled-in file.

# The site's address, without https://
DOMAIN=example.com

# Database credentials. Passwords: long, random, letters and digits only
# (openssl rand -hex 32); each becomes part of an address, where other characters
# would need escaping.
POSTGRES_DB=achalara
# Read and write: the owner, used by the app and the market-data worker.
POSTGRES_USER=achalara
POSTGRES_PASSWORD=
# Read only, the md schema and nothing else: what the Research page uses.
# create-md-reader.sh creates this login; docker-compose.yml builds its address.
# Until the password is set, research reads as the owner, in read-only sessions.
MD_READER_USER=md_reader
MD_READER_PASSWORD=

# Webull market data
WEBULL_APP_KEY=
WEBULL_APP_SECRET=

# SnapTrade brokerage connections
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=
SNAPTRADE_USER_ID=

# Alerts to your phone when something needs a look (optional; see DEPLOY.md).
# Leave both empty for none.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email to clients: their invite and password-reset links (optional; see DEPLOY.md).
# Leave both empty and links are passed on by hand.
RESEND_API_KEY=
MAIL_FROM=

# How long a sign-in lasts, in hours
SESSION_TTL_HOURS=168
LOG_LEVEL=INFO

# Market data (the md worker). The SEC requires a contact email in requests to EDGAR;
# leave empty to skip SEC lookups. OpenFIGI works without a key, more slowly.
SEC_CONTACT_EMAIL=
OPENFIGI_API_KEY=
# Only if market data has a database of its own. Empty: it shares the app's.
MD_DATABASE_URL=
