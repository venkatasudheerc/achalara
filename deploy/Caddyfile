# Caddy obtains and renews the HTTPS certificate for {$DOMAIN} by itself. The
# name must already point at this server, with Cloudflare's proxy off for it.

{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# The API and its health check. The interactive API docs are not exposed.
	@backend path /api/* /health
	handle @backend {
		reverse_proxy backend:8000
	}

	# Everything else is the app; unknown paths are its own routes.
	handle {
		root * /srv/www
		try_files {path} /index.html
		file_server
	}

	# Built files carry a hash in their name, so they can be kept; the page is always fetched fresh.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@page path /index.html /
	header @page Cache-Control "no-cache"
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
